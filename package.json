{
  "name": "xlsx-editor-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/vite",
    "examples/vue"
  ],
  "type": "module",
  "scripts": {
    "reference:fetch": "bun scripts/reference/fetch.ts",
    "reference:check-citations": "bun scripts/reference/check-citations.ts",
    "typecheck": "bun run --filter '*' typecheck && bun check -p tsconfig.json && bun run check:lane-boundaries",
    "build:packages": "bun run --filter '@xlsx-editor.dev/i18n' build && bun run --filter '@xlsx-editor.dev/core' build && bun run --filter '@xlsx-editor.dev/react' build && bun run --filter '@xlsx-editor.dev/vue' build && bun run --filter '@xlsx-editor.dev/editor-api' build",
    "lint": "node scripts/check-max-lines-caps.mjs && node scripts/check-lockfile-workspaces.mjs && oxlint --report-unused-disable-directives-severity=warn packages/*/src/ scripts/ examples/ docs/site/data/",
    "lint:fix": "node scripts/check-max-lines-caps.mjs && node scripts/check-lockfile-workspaces.mjs && oxlint --report-unused-disable-directives-severity=warn --fix packages/*/src/ scripts/ examples/ docs/site/data/",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json,css}\" \"scripts/**/*.{ts,mjs}\" \"examples/*/src/**/*.{ts,tsx,css,vue}\" \"docs/site/data/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json,css}\" \"scripts/**/*.{ts,mjs}\" \"examples/*/src/**/*.{ts,tsx,css,vue}\" \"docs/site/data/**/*.ts\"",
    "test": "node scripts/test/run-parallel.mjs",
    "check:editor-api-license-headers": "bun run --filter '@xlsx-editor.dev/editor-api' license:check",
    "fix:editor-api-license-headers": "bun run --filter '@xlsx-editor.dev/editor-api' license:add",
    "check:license-headers": "bun run check:editor-api-license-headers",
    "test:serial": "bun test --path-ignore-patterns='examples/vite/src/__tests__/**' packages/core packages/ooxml-core packages/editor-api packages/i18n scripts examples docs && bun test --preload ./scripts/test/preload-dom.ts packages/react packages/vue examples/vite/src/__tests__",
    "test:changed": "node scripts/test/changed.mjs",
    "test:docx-shared": "bun scripts/shared/docx-module-tests.ts",
    "check:security": "node scripts/check-security-grep.mjs",
    "check:css-scope": "node scripts/check-css-scope.mjs",
    "check:terminology": "node scripts/check-public-terminology.mjs",
    "check:docs-style": "node scripts/check-docs-style.mjs",
    "check:support-matrix": "bun scripts/check-support-matrix.ts",
    "check:docs": "bun run check:docs-style && bun run check:docs-mdx && bun run check:support-matrix",
    "check:docs-mdx": "node scripts/check-docs-mdx.mjs",
    "check:tsconfig-lib-floor": "node scripts/check-tsconfig-lib-floor.mjs",
    "api:check": "node scripts/api-extractor.mjs",
    "api:extract": "node scripts/api-extractor.mjs --local",
    "check:api-changeset": "node scripts/check-api-changeset.mjs",
    "check:package-artifacts": "node scripts/check-package-artifacts.mjs",
    "check:shipped-shaper": "node scripts/check-shipped-shaper.mjs",
    "check:consumer-install": "node scripts/check-consumer-install.mjs",
    "check:consumer-floors": "node scripts/check-consumer-floors.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "check:package-size": "node scripts/check-package-size.mjs",
    "check:shipped-advisories": "node scripts/check-shipped-advisories.mjs",
    "notices:generate": "bun scripts/generate-third-party-notices.mjs",
    "notices:check": "bun scripts/generate-third-party-notices.mjs --check",
    "geometry:build": "bun scripts/geometry/build-presets.ts",
    "functions:build": "bun scripts/formula/build-functions.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only && node scripts/check-lockfile-workspaces.mjs --fix",
    "prepare": "husky",
    "check:parity": "bun run check:parity-contract && bun run check:composable-parity && bun run check:adapter-css-thin && bun run check:adapter-mirror",
    "check:parity-contract": "bun scripts/check-parity-contract.mjs",
    "check:composable-parity": "node scripts/check-composable-parity.mjs",
    "check:adapter-css-thin": "node scripts/check-adapter-css-thin.mjs",
    "check:adapter-mirror": "node scripts/check-adapter-mirror.mjs",
    "check:lane-boundaries": "node scripts/check-lane-boundaries.mjs",
    "check:lockfile-workspaces": "node scripts/check-lockfile-workspaces.mjs",
    "fixtures:build": "TZ=UTC bun scripts/fixtures/build.ts",
    "fixtures:check": "TZ=UTC bun scripts/fixtures/build.ts --check",
    "validate:xsd": "TZ=UTC bun scripts/validate-xsd.ts",
    "validate:xsd:corpus": "TZ=UTC bun scripts/validate-xsd.ts --corpus",
    "fidelity": "bun scripts/fidelity/cli.ts run",
    "fidelity:check-gaps": "bun scripts/fidelity/cli.ts check-gaps",
    "fidelity:record-reference": "bun scripts/fidelity/cli.ts record-reference",
    "fidelity:census": "TZ=UTC bun scripts/fidelity/census.ts",
    "save-check": "TZ=UTC bun scripts/save-check/cli.ts",
    "test:dom": "bun test --preload ./scripts/test/preload-dom.ts packages/react packages/vue examples/vite/src/__tests__",
    "i18n:validate": "node scripts/validate-i18n.mjs validate && node scripts/check-i18n-unused.mjs",
    "i18n:fix": "node scripts/validate-i18n.mjs validate --fix",
    "i18n:new": "node scripts/validate-i18n.mjs new",
    "i18n:status": "node scripts/validate-i18n.mjs status",
    "i18n:codegen": "node scripts/validate-i18n.mjs codegen",
    "i18n:unused": "node scripts/check-i18n-unused.mjs --list",
    "demo": "bun run --filter ./examples/vite dev",
    "dev:vue": "bun run --filter ./examples/vue dev",
    "build:demos": "bun run build:demo:react && bun run build:demo:vue && bun run build:demo:assemble",
    "build:demo:react": "cd examples/vite && VITE_BASE_PATH=/react/ vite build",
    "build:demo:vue": "cd examples/vue && VITE_BASE_PATH=/vue/ vite build",
    "build:demo:assemble": "rm -rf examples/dist && mkdir -p examples/dist && cp -R examples/vite/dist examples/dist/react && cp -R examples/vue/dist examples/dist/vue",
    "test:e2e": "bun scripts/verify-demo.ts",
    "test:hang:browser": "bun scripts/hang/run.ts",
    "bench:edit": "bun scripts/bench/edit-bench.ts",
    "bench:open:browser": "bun scripts/bench/browser-bench.ts open",
    "bench:edit:browser": "bun scripts/bench/browser-bench.ts edit",
    "bench:scroll:browser": "bun scripts/bench/browser-bench.ts scroll",
    "bench:memory:browser": "bun scripts/bench/browser-bench.ts memory",
    "sample:build": "TZ=UTC bun scripts/sample-workbook/build.ts",
    "sample:save-check": "TZ=UTC bun scripts/sample-workbook/save-check.ts",
    "icons:build": "bun scripts/brand/build-icons.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.4.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-xml-parser": "5.12.1",
    "fflate": "^0.8.3",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "1.94.0",
    "pdfjs-dist": "6.5.438",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "^4.68.4",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "8.3.8"
  },
  "author": "Eigenpal, Inc.",
  "license": "Apache-2.0",
  "homepage": "https://xlsx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/xlsx-editor.git"
  }
}
