{
  "name": "@xlsx-editor.dev/core",
  "version": "0.1.0-beta.2",
  "description": "Framework-agnostic core for XLSX Editor: SpreadsheetML package read and save, the canonical document tree, the cell format cascade, grid layout, paint, and the editor contract that the adapters render.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./cascade": {
      "types": "./dist/cascade.d.ts",
      "import": "./dist/cascade.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./harfbuzz.wasm": "./dist/harfbuzz.wasm",
    "./styles/editor.css": {
      "types": "./src/styles/editor.css.d.ts",
      "default": "./src/styles/editor.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "licenses",
    "src/styles",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "node ../../scripts/check-built-siblings.mjs && tsup && node ../../scripts/build-core-declarations.mjs",
    "typecheck": "bun check && bun check -p tsconfig.consumer.json",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @xlsx-editor.dev/core --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @xlsx-editor.dev/core"
  },
  "dependencies": {
    "@docx-editor.dev/fonts": "^2.38.0",
    "@xlsx-editor.dev/i18n": "^0.1.0-beta.2",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eigenpal/ooxml-core": "workspace:*",
    "harfbuzzjs": "1.6.4",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/xlsx-editor.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
