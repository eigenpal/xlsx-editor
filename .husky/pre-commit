#!/bin/sh

# Keep every whole-repository gate. Same shape as the DOCX Editor hook
# (docx-editor/.husky/pre-commit): format and lint staged files, then run the
# repository gates that nothing else covers.
run_check() {
  check_label="$1"
  shift
  check_started=$(date +%s)
  printf '\nRunning %s...\n' "$check_label"
  if "$@"; then
    printf 'Passed %s (%ss)\n' "$check_label" "$(($(date +%s) - check_started))"
  else
    check_status=$?
    printf 'Failed %s (%ss, exit %s)\n' "$check_label" "$(($(date +%s) - check_started))" "$check_status" >&2
    exit "$check_status"
  fi
}

run_check 'staged formatting and lint' npx lint-staged
run_check 'TypeScript type check' bun run typecheck
run_check 'lint' bun run lint
run_check 'i18n validation' bun run i18n:validate
run_check 'security grep' bun run check:security
run_check 'public terminology' bun run check:terminology
run_check 'documentation checks' bun run check:docs
run_check 'lane boundaries' bun run check:lane-boundaries
run_check 'fixtures match their build' bun run fixtures:check
run_check 'schema validation of saved parts' bun run validate:xsd
run_check 'formatting check' bun run format:check
# DOCX Editor runs check:tsconfig-lib-floor in CI only. Difference: this hook also runs it,
# because it reads only the tsconfig files and needs no build.
run_check 'tsconfig lib floor' bun run check:tsconfig-lib-floor
# API Extractor reads the built declarations, so build first, as in PPTX Editor's hook.
# Difference: the build output prints when the build fails, so the cause shows.
run_check 'API snapshot check' sh -c 'out=$(bun run build:packages 2>&1) || { printf "%s\n" "$out"; exit 1; }; bun run api:check'
